# API local
PORT=3000

# Conexao MySQL no formato:
# mysql://USUARIO:SENHA@HOST:PORTA/BANCO
#
# Com "docker compose up", o MySQL fica disponível no host pela porta 3307.
# Usuário, senha e banco correspondem aos padrões do compose.yaml.
MYSQL_DATABASE=dwello
MYSQL_USER=dwello
MYSQL_PASSWORD=dwello
MYSQL_ROOT_PASSWORD=altere-esta-senha-no-ambiente-local
DATABASE_URL=mysql://dwello:dwello@127.0.0.1:3307/dwello

# Portas publicadas no Docker. Altere se já estiverem em uso no computador.
MYSQL_PORT=3307
API_PORT=3000
FRONTEND_PORT=3001
#
# Se a API tambem estiver dentro do Docker Compose, use:
# DATABASE_URL=mysql://dwello:dwello@db:3306/dwello

# Obrigatorio: segredo usado para assinar as sessoes.
# Use pelo menos 32 caracteres e nunca compartilhe este valor.
BETTER_AUTH_SECRET=gere-um-segredo-local-com-pelo-menos-32-caracteres

# URL publica da API e origem permitida pelo frontend.
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Armazenamento de arquivos fora do banco.
UPLOAD_DIR=storage/uploads

# OAuth opcional. So habilite quando possuir credenciais proprias.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
